# Copy this file to `.env` and fill in your real values.
# The `.env` file is git-ignored and must never be committed.
# Every value below is a PLACEHOLDER — never commit real credentials.

# Neon PostgreSQL connection string (psycopg3 driver).
# Create a database at https://console.neon.tech and copy its connection string.
DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/<dbname>?sslmode=require

# Runtime environment: development | production
ENVIRONMENT=development
APP_NAME=Student Command Center API

# Comma-separated list of allowed CORS origins.
# Dev: the Vite dev server. Prod: your deployed frontend origin exactly.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── OpenRouter AI (server-side only) ─────────────────────────────
# Generate a key at https://openrouter.ai/keys and put it in backend/.env.
# This file is a template — NEVER commit real credentials anywhere.
OPENROUTER_API_KEY=sk-or-v1-REPLACE_WITH_YOUR_KEY
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free

# Cost / behavior guardrails (optional overrides).
# AI_REQUEST_TIMEOUT_SECONDS=45
# AI_MAX_OUTPUT_TOKENS=700
# AI_HISTORY_LIMIT=12
# AI_CONTEXT_BUDGET_CHARS=6000
# AI_RATE_LIMIT_PER_MINUTE=20
# AUTH_RATE_LIMIT_PER_MINUTE=60

# JWT signing key. Generate with a random 48-byte url-safe token, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-secret
# Token lifetime in minutes (default: 7 days).
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Migration-time dev account (OPTIONAL) ────────────────────────
# The Alembic migration creating the users table only creates a dev account
# when BOTH of these are set at migration time (safe default: none). Required
# only when upgrading a database that already contains data. Never commit the
# real password — provide it via the environment when you run `alembic upgrade`.
# DEV_USER_EMAIL=you@example.com
# DEV_USER_PASSWORD=set-a-strong-password-here